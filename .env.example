# App Configuration
NEXT_PUBLIC_APP_NAME=NaviDash
NEXT_PUBLIC_DEFAULT_LOCALE=zh-CN

# Default bookmarks data
NEXT_PUBLIC_DEFAULT_BOOKMARKS=[]

# Demo Mode (true/false)
# If true, data persistence is disabled (for Vercel/demo deployment)
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Optional single-user access protection.
# Leave empty to keep the homepage open.
NAVIDASH_ACCESS_PASSWORD=

# Weather
# Server-side weather proxy configuration for QWeather (HeWeather).
QWEATHER_API_KEY=
# Optional custom QWeather-compatible host, e.g. api.example.com
QWEATHER_API_HOST=
# Optional auth mode: apikey or jwt
QWEATHER_AUTH_TYPE=apikey

# Komari
# Fixed server-side Komari instance. Never expose this value or the API key in a Widget config.
KOMARI_BASE_URL=
# Optional Bearer API key for private instances or hidden nodes.
KOMARI_API_KEY=
